      data = outside_bounds[outside_bounds$lower_truncated, ],
      aes(x = x_lower, xend = capped_upper, y = Outcome, yend = Outcome),
      arrow = arrow(length = unit(0.1, "cm"), ends = "first", type = "closed"),
