pair_comparison <- controls %>%
  transmute(
    control_patid = patid,
    matched_case_patid,
    case_index_date,
    n_controls,
    pair_weight = 1 / n_controls,
    control_dob = dob,
    control_gender = gender,
    control_ethnicity = ethnicity_5cat,
    control_imd = imd_decile
  ) %>%
  left_join(
    cases %>%
      transmute(
        matched_case_patid = patid,
        case_dob = dob,
        case_gender = gender,
        case_ethnicity = ethnicity_5cat,
        case_imd = imd_decile
      ),
    by = "matched_case_patid"
  ) %>%
  mutate(
    case_age = as.numeric(case_index_date - case_dob) / 365.25,
    control_age = as.numeric(case_index_date - control_dob) / 365.25,

    # Positive differences mean the case has the higher value
    age_difference = case_age - control_age,
    absolute_age_gap = abs(age_difference),
    imd_difference = case_imd - control_imd,
    absolute_imd_gap = abs(imd_difference),

    same_gender = if_else(
      case_gender == "Missing" | control_gender == "Missing",
      NA, case_gender == control_gender
    ),
    same_ethnicity = if_else(
      case_ethnicity == "Missing" | control_ethnicity == "Missing",
      NA, case_ethnicity == control_ethnicity
    ),
    same_imd_missingness = is.na(case_imd) == is.na(control_imd)
  )

# Inspect pairs with the largest age gaps
pair_comparison %>%
  arrange(desc(absolute_age_gap)) %>%
  print(n = 20, width = Inf)

View(pair_comparison)

#####

pair_summary <- pair_comparison %>%
  transmute(
    pair_weight,
    age_difference,
    absolute_age_gap,
    imd_difference,
    absolute_imd_gap,
    percent_same_gender = 100 * as.numeric(same_gender),
    percent_same_ethnicity = 100 * as.numeric(same_ethnicity),
    percent_same_imd_missingness = 100 * as.numeric(same_imd_missingness)
  ) %>%
  pivot_longer(
    -pair_weight,
    names_to = "measure",
    values_to = "value"
  ) %>%
  group_by(measure) %>%
  summarise(
    total_pairs = n(),
    evaluable_pairs = sum(!is.na(value)),
    unweighted_mean = safe_mean(value),
    weighted_mean = safe_mean(value, pair_weight),
    .groups = "drop"
  )

print(pair_summary, n = Inf, width = Inf)