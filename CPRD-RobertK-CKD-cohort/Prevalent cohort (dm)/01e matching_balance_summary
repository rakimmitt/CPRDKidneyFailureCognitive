# FALSE: assess balance among matched cases and their controls.
# TRUE: compare ALL cached cases against the selected controls.
include_unmatched_cases <- TRUE

# Read the saved table without rerunning matching
cohort <- tbl(
  analysis$.con,
  dbplyr::in_schema(
    analysis$.analysisDb,
    "rk_ckd_matched_cohort"
  )
) %>%
  select(
    patid, is_case, matched_case_patid, matched_case_index_date,
    index_date, dob, gender, ethnicity_5cat, imd_decile
  ) %>%
  collect() %>%
  mutate(
    across(c(patid, matched_case_patid), as.character),
    is_case = as.integer(as.character(is_case)),
    across(c(index_date, matched_case_index_date, dob), as.Date),
    gender = coalesce(as.character(gender), "Missing"),
    ethnicity_5cat = coalesce(as.character(ethnicity_5cat), "Missing"),
    imd_decile = as.numeric(na_if(as.character(imd_decile), "Missing"))
  )

# Checks for your matching design: one row per patient, no control reuse
stopifnot(
  !anyNA(cohort$patid),
  !anyDuplicated(cohort$patid),
  !anyNA(cohort$is_case),
  all(cohort$is_case %in% c(0L, 1L))
)

cases <- cohort %>% filter(is_case == 1L)
controls <- cohort %>% filter(is_case == 0L)

stopifnot(
  nrow(cases) > 0,
  nrow(controls) > 0,
  !anyNA(controls$matched_case_patid),
  all(controls$matched_case_patid %in% cases$patid)
)

set_sizes <- controls %>%
  count(matched_case_patid, name = "n_controls")

cases <- cases %>%
  left_join(set_sizes, by = c("patid" = "matched_case_patid")) %>%
  mutate(n_controls = coalesce(n_controls, 0L))

# How many cases received each number of controls?
matching_counts <- cases %>%
  count(n_controls, name = "number_of_cases")

print(matching_counts, n = Inf)

# Use the linked case's index date as the authoritative date for controls
controls <- controls %>%
  left_join(set_sizes, by = "matched_case_patid") %>%
  left_join(
    cases %>%
      transmute(matched_case_patid = patid, case_index_date = index_date),
    by = "matched_case_patid"
  )

stopifnot(
  !anyNA(controls$case_index_date),
  !anyNA(controls$index_date),
  !anyNA(controls$matched_case_index_date),
  all(controls$index_date == controls$case_index_date),
  all(controls$matched_case_index_date == controls$case_index_date)
)

balance_cases <- cases %>%
  filter(include_unmatched_cases | n_controls > 0)

balance_data <- bind_rows(
  balance_cases %>%
    mutate(group = "Cases", weight = 1, assessment_date = index_date),
  controls %>%
    mutate(
      group = "Controls",
      weight = 1 / n_controls,
      assessment_date = case_index_date
    )
) %>%
  mutate(
    age = as.numeric(assessment_date - dob) / 365.25
  )

# Raw and weighted group sizes
balance_data %>%
  group_by(group) %>%
  summarise(
    patients = n(),
    total_weight = sum(weight),
    .groups = "drop"
  ) %>%
  print()

  #####

  # Mean that safely handles missing values
safe_mean <- function(x, w = rep(1, length(x))) {
  keep <- !is.na(x) & !is.na(w) & w > 0
  if (!any(keep)) return(NA_real_)
  weighted.mean(x[keep], w[keep])
}

# Continuous variables
continuous_long <- balance_data %>%
  select(group, weight, age, imd_decile) %>%
  pivot_longer(
    c(age, imd_decile),
    names_to = "variable",
    values_to = "value"
  ) %>%
  mutate(category = "Mean", type = "Continuous")

# One 0/1 indicator for every gender and ethnicity category
categorical_long <- map_dfr(
  c("gender", "ethnicity_5cat"),
  function(v) {
    map_dfr(sort(unique(balance_data[[v]])), function(level) {
      tibble(
        group = balance_data$group,
        weight = balance_data$weight,
        variable = v,
        category = level,
        type = "Percentage",
        value = as.numeric(balance_data[[v]] == level)
      )
    })
  }
)

# Missingness is assessed separately from observed numerical values
missing_long <- map_dfr(c("age", "imd_decile"), function(v) {
  tibble(
    group = balance_data$group,
    weight = balance_data$weight,
    variable = v,
    category = "Missing",
    type = "Percentage",
    value = as.numeric(is.na(balance_data[[v]]))
  )
})

balance_long <- bind_rows(
  continuous_long, categorical_long, missing_long
)

# Fixed case-reference denominator
denominators <- balance_long %>%
  filter(group == "Cases") %>%
  group_by(variable, category, type) %>%
  summarise(
    denominator = if (first(type) == "Continuous") {
      sd(value, na.rm = TRUE)
    } else {
      p <- safe_mean(value)
      sqrt(p * (1 - p))
    },
    .groups = "drop"
  )

overall_balance <- balance_long %>%
  group_by(variable, category, type, group) %>%
  summarise(
    observed_n = sum(!is.na(value)),
    unweighted = safe_mean(value),
    weighted = safe_mean(value, weight),
    .groups = "drop"
  ) %>%
  pivot_wider(
    names_from = group,
    values_from = c(observed_n, unweighted, weighted)
  ) %>%
  left_join(
    denominators,
    by = c("variable", "category", "type")
  ) %>%
  mutate(
    unweighted_smd = if_else(
      is.finite(denominator) & denominator > 0,
      (unweighted_Cases - unweighted_Controls) / denominator,
      NA_real_
    ),
    weighted_smd = if_else(
      is.finite(denominator) & denominator > 0,
      (weighted_Cases - weighted_Controls) / denominator,
      NA_real_
    ),
    absolute_weighted_smd = abs(weighted_smd),

    # Display categorical values as percentages, after calculating SMDs
    across(
      c(unweighted_Cases, unweighted_Controls,
        weighted_Cases, weighted_Controls),
      ~ if_else(type == "Percentage", .x * 100, .x)
    )
  ) %>%
  select(-denominator) %>%
  arrange(desc(absolute_weighted_smd))

print(overall_balance, n = Inf, width = Inf)

# Optional spreadsheet-style display
View(overall_balance)

